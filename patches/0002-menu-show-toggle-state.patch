+bool
+action_get_toggle_state(struct action *action, struct view *view, bool *state)
+{
+	assert(action && view && state);
+	switch (action->type) {
+	case ACTION_TYPE_TOGGLE_ALWAYS_ON_TOP:
+		*state = view->layer == VIEW_LAYER_ALWAYS_ON_TOP;
+		return true;
+	case ACTION_TYPE_TOGGLE_ALWAYS_ON_BOTTOM:
+		*state = view->layer == VIEW_LAYER_ALWAYS_ON_BOTTOM;
+		return true;
+	case ACTION_TYPE_TOGGLE_OMNIPRESENT:
+		*state = view->visible_on_all_workspaces;
+		return true;
+	case ACTION_TYPE_TOGGLE_SHADE:
+		*state = view->shaded;
+		return true;
+	default:
+		return false;
+	}
+}
