 }
 
+/*
+ * Prefix menu items that toggle a view state (always on top, omnipresent,
+ * shade, ...) with a checked/unchecked box so the current state is visible.
+ */
+#define TOGGLE_ON "\xe2\x98\x91 "   /* U+2611 BALLOT BOX WITH CHECK */
+#define TOGGLE_OFF "\xe2\x98\x90 "  /* U+2610 BALLOT BOX */
+#define TOGGLE_PREFIX_LEN 4 /* 3 byte UTF-8 character + space */
+
+static void
+menu_recreate_scene(struct menu *menu)
+{
+	struct menuitem *item;
+	wl_list_for_each(item, &menu->menuitems, link) {
+		/* The item trees are destroyed together with the menu tree */
+		item->tree = NULL;
+		item->normal_tree = NULL;
+		item->selected_tree = NULL;
+	}
+	wlr_scene_node_destroy(&menu->scene_tree->node);
+	menu->scene_tree = NULL;
+	menu_create_scene(menu);
+}
+
+static void
+update_toggle_state_labels(struct menu *menu)
+{
+	struct view *view = menu->triggered_by_view;
+	if (!view) {
+		return;
+	}
+
+	bool changed = false;
+	struct menuitem *item;
+	wl_list_for_each(item, &menu->menuitems, link) {
+		if (item->type != LAB_MENU_ITEM || wl_list_empty(&item->actions)) {
+			continue;
+		}
+		struct action *action;
+		wl_list_for_each(action, &item->actions, link) {
+			break;
+		}
+		bool state;
+		if (!action_get_toggle_state(action, view, &state)) {
+			continue;
+		}
+
+		const char *base = item->text;
+		if (!strncmp(base, TOGGLE_ON, TOGGLE_PREFIX_LEN)
+				|| !strncmp(base, TOGGLE_OFF, TOGGLE_PREFIX_LEN)) {
+			base += TOGGLE_PREFIX_LEN;
+		}
+		struct buf buf = BUF_INIT;
+		buf_add(&buf, state ? TOGGLE_ON : TOGGLE_OFF);
+		buf_add(&buf, base);
+		free(item->text);
+		item->text = xstrdup(buf.data);
+		buf_reset(&buf);
+
+		item->native_width = font_width(&rc.font_menuitem, item->text);
+		changed = true;
+	}
+
+	if (changed && menu->scene_tree) {
+		menu_recreate_scene(menu);
+	}
+}
