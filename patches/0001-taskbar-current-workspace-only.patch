--- a/src/view-impl-common.c
+++ b/src/view-impl-common.c
@@ -2,10 +2,42 @@
 /* view-impl-common.c: common code for shell view->impl functions */
 #include "view-impl-common.h"
 #include "foreign-toplevel/foreign.h"
+#include "config/rcxml.h"
 #include "labwc.h"
 #include "view.h"
 #include "window-rules.h"
 
+void
+view_update_foreign_toplevel(struct view *view)
+{
+	/*
+	 * Respect skipTaskbar rules and exclude unfocusable views (popups,
+	 * floating toolbars, etc.) as these should not be shown in
+	 * taskbars/docks/etc.
+	 */
+	bool want = view_is_focusable(view)
+		&& window_rules_get_property(view, "skipTaskbar")
+			!= LAB_PROP_TRUE;
+
+	if (want && rc.workspace_config.taskbar_current_only) {
+		want = view->visible_on_all_workspaces
+			|| view->workspace == view->server->workspaces.current;
+	}
+
+	if (want && !view->foreign_toplevel) {
+		view->foreign_toplevel = foreign_toplevel_create(view);
+
+		struct view *parent = view->impl->get_parent(view);
+		if (parent && parent->foreign_toplevel) {
+			foreign_toplevel_set_parent(view->foreign_toplevel,
+				parent->foreign_toplevel);
+		}
+	} else if (!want && view->foreign_toplevel) {
+		foreign_toplevel_destroy(view->foreign_toplevel);
+		view->foreign_toplevel = NULL;
+	}
+}
+
